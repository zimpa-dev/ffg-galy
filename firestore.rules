rules_version = '2';

// Règles de sécurité Firestore pour FFG-Galy
// - Contenu public : lecture ouverte, écriture réservée aux administrateurs connectés
// - Données sensibles (bénévoles, dons) : accès réservé aux administrateurs connectés
//
service cloud.firestore {
  match /databases/{database}/documents {

    // L'accès est réservé au compte admin vérifié.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@ffg-ve.org'
        && request.auth.token.email_verified == true;
    }

    // --- Contenu affiché sur le site public ---
    match /news/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Données réservées à l'administration ---
    match /volunteers/{doc} {
      // Ouvrir `create` à tous si un formulaire public d'inscription est ajouté un jour
      allow read, write: if isAdmin();
    }

    match /donations/{doc} {
      allow read, write: if isAdmin();
    }

    // Tout le reste est refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
